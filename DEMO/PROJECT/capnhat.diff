+     def ui(self, fn, *args, **kwargs):
+         """Chạy hàm fn trên main thread (Tkinter event loop)."""
+         try:
+             self.after(0, lambda: fn(*args, **kwargs))
+         except Exception:
+             # Nếu app đang đóng, after có thể fail; bỏ qua.
+             pass
+ 
+     def ask_yesno_threadsafe(self, title: str, msg: str) -> bool:
+         """
+         Hiển thị messagebox.askyesno trên main thread nhưng cho phép thread receive chờ kết quả.
+         Tránh crash do gọi messagebox từ thread phụ.
+         """
+         ev = threading.Event()
+         result = {"value": False}
+ 
+         def _ask():
+             try:
+                 result["value"] = messagebox.askyesno(title, msg)
+             except Exception:
+                 result["value"] = False
+             finally:
+                 ev.set()
+ 
+         self.ui(_ask)
+         ev.wait()  # chờ user bấm Yes/No
+         return bool(result["value"])
